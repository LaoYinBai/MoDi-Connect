<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:about="clr-namespace:MoDi.Presentation.About"
             xmlns:markdown="clr-namespace:MoDi.Presentation.Markdown"
             x:Class="MoDi.Presentation.About.DocumentDialogView"
             x:DataType="about:AboutPageViewModel"
             IsVisible="{Binding IsDocumentDialogOpen}"
             TextElement.FontFamily="{DynamicResource FontFamilyDefault}"
             TextElement.FontSize="{DynamicResource FontSizeBody}">
  <Border Margin="80,48" Padding="20" CornerRadius="12" BorderThickness="1"
          BorderBrush="{DynamicResource BorderDefault}" Background="{DynamicResource SurfaceCard}">
    <Grid RowDefinitions="Auto,*" RowSpacing="12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="page-title" Foreground="{DynamicResource TextPrimary}"
                   Text="{Binding ActiveDocument.Title}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding ActiveDocument.LoadCommand}" Content="重新加载" />
          <Button Command="{Binding CloseDocumentCommand}" Content="关闭" />
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <markdown:MarkdownDocumentView DataContext="{Binding ActiveDocument}" />
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
