<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Double x:Key="ChromeHeight">48</x:Double>
  <x:Double x:Key="StatusHeight">32</x:Double>
  <x:Double x:Key="SpaceXs">4</x:Double>
  <x:Double x:Key="SpaceSm">8</x:Double>
  <x:Double x:Key="SpaceMd">12</x:Double>
  <x:Double x:Key="SpaceLg">20</x:Double>
  <Thickness x:Key="PagePadding">20</Thickness>
  <Thickness x:Key="CardPadding">16</Thickness>
  <Thickness x:Key="ControlPadding">12,7</Thickness>
  <Thickness x:Key="ControlPaddingCompact">10,5</Thickness>
</ResourceDictionary>
