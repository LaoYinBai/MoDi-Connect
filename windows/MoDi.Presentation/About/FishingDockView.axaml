<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MoDi.Presentation.About.FishingDockView"
             TextElement.FontFamily="{DynamicResource FontFamilyDefault}"
             TextElement.FontSize="{DynamicResource FontSizeBody}">
  <Border Height="260" CornerRadius="12" ClipToBounds="True"
          BorderThickness="1" BorderBrush="{DynamicResource BorderDefault}"
          Background="{DynamicResource SurfaceCardSecondary}">
    <Image x:Name="FishingDockImage"
           Source="avares://MoDi.Presentation/Assets/About/fishing-dock.png"
           Stretch="UniformToFill" />
  </Border>
</UserControl>
