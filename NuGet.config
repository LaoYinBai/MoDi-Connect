<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="modi-protocol-local" value="third_party/modi-protocol/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="modi-protocol-local">
      <package pattern="MoDi.Protocol" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="Avalonia*" />
      <package pattern="Common.Logging*" />
      <package pattern="Concentus" />
      <package pattern="HarfBuzzSharp*" />
      <package pattern="InTheHand.Net.Bluetooth" />
      <package pattern="IPNetwork2" />
      <package pattern="Makaretu.Dns*" />
      <package pattern="Material.Icons*" />
      <package pattern="MicroCom.Runtime" />
      <package pattern="Microsoft.*" />
      <package pattern="NAudio*" />
      <package pattern="NETStandard.Library" />
      <package pattern="Newtonsoft.Json" />
      <package pattern="QRCoder" />
      <package pattern="SimpleBase" />
      <package pattern="SkiaSharp*" />
      <package pattern="System.*" />
      <package pattern="Tmds.*" />
      <package pattern="xunit*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
