<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:about="clr-namespace:MoDi.Presentation.About"
             x:Class="MoDi.Presentation.About.StoryCard"
             x:DataType="about:StoryCardViewModel"
             TextElement.FontFamily="{DynamicResource FontFamilyDefault}"
             TextElement.FontSize="{DynamicResource FontSizeBody}">
  <Border MinHeight="168" Padding="16" CornerRadius="10" BorderThickness="1"
          BorderBrush="{DynamicResource BorderDefault}" Background="{DynamicResource SurfaceCard}">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="section-title" Foreground="{DynamicResource TextPrimary}" Text="{Binding Title}" />
        <TextBlock Grid.Column="1" Classes="annotation" Foreground="{DynamicResource TextMuted}" Text="{Binding CountText}" />
      </Grid>
      <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding LatestTitle}" />
      <TextBlock Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxLines="3"
                 TextTrimming="CharacterEllipsis" Text="{Binding Preview}" />
      <Button x:Name="OpenStoriesButton" HorizontalAlignment="Left"
              Command="{Binding OpenLibraryCommand}" Content="查看故事汇" />
    </StackPanel>
  </Border>
</UserControl>
