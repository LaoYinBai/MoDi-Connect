<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:about="clr-namespace:MoDi.Presentation.About"
             xmlns:markdown="clr-namespace:MoDi.Presentation.Markdown"
             x:Class="MoDi.Presentation.About.SponsorCard"
             x:DataType="about:SponsorCardViewModel"
             TextElement.FontFamily="{DynamicResource FontFamilyDefault}"
             TextElement.FontSize="{DynamicResource FontSizeBody}">
  <Border MinHeight="150" Padding="16" CornerRadius="10" BorderThickness="1"
          BorderBrush="{DynamicResource BorderDefault}" Background="{DynamicResource SurfaceCard}">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="section-title" Foreground="{DynamicResource TextPrimary}" Text="{Binding Title}" />
        <Button Grid.Column="1" Command="{Binding OpenSponsorCommand}" Content="赞助页面" />
      </Grid>
      <markdown:MarkdownDocumentView DataContext="{Binding Content}" />
      <TextBlock Classes="annotation" Foreground="{DynamicResource Error}" Text="{Binding ErrorMessage}" />
    </StackPanel>
  </Border>
</UserControl>
